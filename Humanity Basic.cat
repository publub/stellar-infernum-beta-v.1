      </infoLinks>
      <profiles>
        <profile name="Jakil Heavy Weapon Team" id="1b8b-b9be-9d9b-50f5" hidden="false" typeId="c547-1836-d8a-ff4f" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="e703-ecb6-5ce7-aec1">5&quot;</characteristic>
            <characteristic name="H" typeId="d29d-cf75-fc2d-34a4">6</characteristic>
            <characteristic name="T" typeId="450-a17e-9d5e-29da">4</characteristic>
            <characteristic name="RS/MS" typeId="58d2-b879-49c7-43bc">4+/8+</characteristic>
            <characteristic name="L" typeId="bef7-942a-1a23-59f8">9+</characteristic>
            <characteristic name="C" typeId="ce19-d3eb-6d64-97de">3</characteristic>
          </characteristics>
        </profile>
        <profile name="Armoured Emplacement" id="9ec5-4a61-0557-6a52" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a ranged attack is allocated to a model from your army, if that model is not fully visible to every model in the attacking unit because of this model, that model is considered to have the benefit of Light Cover.</characteristic>
          </characteristics>
        </profile>
        <profile name="Suppressing fire" id="a792-78f6-d3fa-7ad7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After this unit has resolved its attacks, if an enemy unit on a Killzone was hit by one or more of those attacks, it suffers -1 to its Ranged Skill.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
