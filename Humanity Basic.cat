        <profile name="Laid Mines" id="4a3f-e873-bb43-e863" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per game, during the strategy step, select one objective market or Killzone this unit is within range of. This unit may then place a Mine marker on that objective or Killzone.</characteristic>
          </characteristics>
        </profile>
        <profile name="Detonate! (Action)" id="f391-6707-110d-a4ff" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per game, when you select this unit to activate, it may instead use this Action:


Detonate this units Mine marker. Each unit with 3&quot; of this units Mine marker suffers D4+1 fatal wounds. Then remove this units Mine marker.</characteristic>
          </characteristics>
        </profile>
