      </categoryLinks>
      <constraints>
        <constraint id="3f4f-f653-a3c9-e9de" field="selections" includeChildForces="false" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="105c-4279-0052-ec24" field="selections" includeChildForces="false" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Mass Mobilisation" id="9ab0-1328-f1b4-1699" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Send the next wave" id="4cc7-fbf5-4e79-41be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, the first time a friendly Jakil Conscript Unit is destroyed, add a new Jakil Conscript Unit to your Reinforcement Pool.</characteristic>
              </characteristics>
            </profile>
            <profile name="Mass Mobilisation" id="cd6a-49e0-fbf0-383e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, after a friendly Jakil unit has resolved their activation. You may select one Jakil Conscript unit that has not already activated, to activate before your opponent makes their next activation.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="9401-3a0a-117c-0e32" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+2 units with the Troop keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Soldiers of Jasilia" id="d3c2-9813-4445-3f19" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Urban Warfare specalists" id="46ca-569a-2a25-4fa3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly Jakil unit is wholly within a terrain area it gains Stealth 24&quot;, it loses this ability once it makes a ranged attack or an attack is made against it.</characteristic>
              </characteristics>
            </profile>
            <profile name="Soldiers of Jasili" id="0678-1a83-ccae-570e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly Jakil unit targets an enemy unit within range of an Objective or Killzone, add one to the hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guerilla Fighters" id="d18d-eaa4-82bc-dd2e" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Home territory advantage" id="d13f-9214-6ae7-724c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the deployment step, when you would place your Killzone, instead place 2 Killzones more than 3&quot; away from your opponents deployment zone. Enemy units within 3&quot; of these Killzone markers are considered in the Killzone instead of 6&quot;.</characteristic>
              </characteristics>
            </profile>
            <profile name="Adaptable warfare" id="7e5c-8fce-3d80-4e87" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the strategy step, select one Killzone marker on the board and remove it. Place a new Killzone marker on the board more than 3&quot; away from the opponents deployment zone. Enemy units within 3&quot; of this Killzone marker are considered in the Killzone.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="c6a7-f4f1-5572-5345" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+1 unit with the Prime keyword.
-1 unit with the Heavy Support keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
