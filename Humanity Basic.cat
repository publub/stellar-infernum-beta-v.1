  <sharedInfoGroups>
    <infoGroup name="Internals:" id="dfdb-bacd-ef4c-f397" hidden="false">
      <profiles>
        <profile name="Arms / Appendages " id="ffef-2336-ea8e-aad3" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Units Melee weapons gain [Heavy]. If a weapon already contains the [Heavy] keyword, then that weapon can only hit on a hit roll of 8.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Communications / Senses " id="2cac-99ee-26dd-a49b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Unit can no longer be the target of Requisitions or abilities.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Crew / Pilot " id="79c5-cdf7-f0ea-8e04" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Unit must subtract 2 from all leadership tests.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Energy shield " id="615a-9e43-6456-9617" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit loses its Shielded Save ability.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Hull / Body " id="cc9f-c5fe-baf8-fa76" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">All weapons targeting this Unit gain +1AP.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tracks / Wheels / Legs" id="5417-785f-2975-88d0" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Unit suffers -2&quot; to its move characteristic.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Wings / Thrusters " id="c486-70d1-d8fb-7028" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Unit the Fly keyword.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true"/>
          </modifiers>
        </profile>
        <profile name="Turrets" id="6a7a-ffb8-6156-af3b" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This Units ranged weapons gain [Heavy]. If a weapon already contains the [Heavy] keyword, then that weapon can only hit on a hit roll of 8.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
