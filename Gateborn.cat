    <selectionEntryGroup name="Riftwalker" id="3e3b-a98f-d10a-27e9" hidden="false">
      <constraints>
        <constraint id="5d1e-f814-f3a2-7e99" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Thunderous Impact" id="9e24-8c42-6877-71c7" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Thunderous Impact" id="1bcd-fcde-c7e9-d97c" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, after this model has performed an action, pick one enemy unit within Close Combat Range and roll a number of D8 equal to its remaining health. For each 6+ that unit suffers one fatal wound to a maximum of 6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Walking Terror" id="3910-61a2-ee7e-b23b" hidden="false" import="true" type="upgrade">
