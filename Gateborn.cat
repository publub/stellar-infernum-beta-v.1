    <selectionEntryGroup name="Detachment" id="36cf-28eb-c446-0566" hidden="false">
      <categoryLinks>
        <categoryLink name="Configuration" id="1243-da9e-1231-00be" hidden="false" primary="true" targetId="c708-30bf-1ea7-3e08"/>
      </categoryLinks>
      <constraints>
        <constraint id="f23c-5d0c-fb33-15de" field="selections" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="bbfc-2745-c0ea-aa1f" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Horrors beyond comprehension" id="3df4-5e30-abe3-6215" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Rifts of Madness" id="5bba-dff9-ee64-479e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units within range of an objective marker you control suffer -1 to all leadership tests.</characteristic>
              </characteristics>
            </profile>
            <profile name="Gatespace traversal" id="385c-24c3-ce1b-c301" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">In the Strategy step, select one friendly GATEBORN unit within range of a Rift marker and place that unit into Reinforcements. During the Reinforcements step any GATEBORN units may be set up wholly within range of Rift markers but cannot be set up within Close Combat Range of enemy units.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Swarms from beyond" id="045f-90a3-2746-4858" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Boundless Seas of incorporeality " id="a4e2-be84-70cc-e1a8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Friendly Infantry and Swarm units you control have the Restistance 8+ ability.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="edab-c33d-43e5-7099" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+2 units with the Troops keyword.
-2 units with the Heavy Support Keyword</characteristic>
              </characteristics>
            </profile>
            <profile name="Ever present, ever watching" id="fa29-70b8-920e-e4c7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Enemy units within range of objective markers you control have -1 to their control characteristic.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="As reality unravels" id="3358-5948-7d52-3203" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Gaze upon endless misunderstanding" id="c326-3445-eae4-71e7" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Your army gains increasing abilities as the Temporal Instability count rises.


1: Gateborn units in your army add 1 to leadership rolls.
2-3: Gateborn units in your army can be targeted by the Reroll requisition without paying the requisition cost.
4-5: Attacks made against Gateborn units in your army have -1 to hit rolls.
6-7: Gateborn units in your army gain +2 to manifestation tests.
8-9: At the strategy phase, friendly Gateborn Accultist units in your army regain D4+1 wounds.
10+: Enemy units that start or end an action within 6&quot; take D4+1 fatal wounds.</characteristic>
              </characteristics>
            </profile>
            <profile name="Invert Polarity (Spell)" id="0aa0-d3f5-cd4b-3c65" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly Accultist unit activates it may cast this spell.


Invert Polarity (Cost: 7)


Effect: Increase the Temporal Instability count by 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="bdf2-a8c1-f072-aaba" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+2 units with the Prime keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
