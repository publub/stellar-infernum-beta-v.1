        <constraint id="8477-787b-fc45-8cc0" field="selections" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7fdf-eb4c-ec75-c613" field="selections" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Empire Ascendant" id="b1c6-9005-ebd8-c457" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Guided by Stars" id="dec9-b110-0cd4-4380" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per game, when you target a friendly Frenzied unit with a requisition you may reduce the cost of that requisition by 1.</characteristic>
              </characteristics>
            </profile>
            <profile name="Empire Ascendant" id="e7c2-2b90-4492-1c54" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When a friendly unit targets an enemy unit within range of an Objective marker, reroll hit rolls of 1. In addition, if that unit is Frenzied that unit can reroll wound rolls of 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hunters of the Empire" id="b746-58b9-ef5e-d673" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Alien assassins" id="7cda-6df3-2e7e-c2be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After a friendly Chunari unit has made an assault move, add 1 to the attacks and strength characteristics of melee weapons in that unit until the end of the turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="Predatory Instincts" id="fd11-a538-ad1e-85f8" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Each time a Frenzied Chunari unit makes a melee attack, add +1 to the hit roll if the target is below starting strength.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="d53c-337c-91e1-9080" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+1 unit with the Prime keyword.
-1 unit with the Heavy Support keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Unstable Warband" id="d628-aa93-d3ba-3358" hidden="false" import="true" type="upgrade">
          <profiles>
            <profile name="Devotees of the blood" id="772f-30e9-de2a-4e07" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">At the start of the first turn before the game begins, you can give a number of units 6 frenzy counters. The number of units you can select depends on the battlesize, as follows:

INCURSION: 1 UNIT
STRIKE FORCE: 2 UNITS
ONSLAUGHT: 3 UNITS</characteristic>
              </characteristics>
            </profile>
            <profile name="Ritual Sites" id="4486-0837-d75d-e505" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">During the strategy step, select one objective marker either in No mans land, or that you don&apos;t control. Friendly Chunari units within range of that objective marker are considered to be Frenzied.</characteristic>
              </characteristics>
            </profile>
            <profile name="Force Changes" id="4969-7945-acac-ea3a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When taking this detachment, your Army may contain:
+2 units with the Troops keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
