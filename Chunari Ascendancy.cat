    <selectionEntry name="Berserker " id="50e2-b095-9edc-4658" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Prime" id="adfb-9790-e05f-0e95" primary="true" targetId="0558-6d8b-f5d1-cca3"/>
        <categoryLink name="Chunari Empire" id="d31a-ae0f-8325-7f5f" primary="false" targetId="22d4-7f1c-8932-5a92"/>
        <categoryLink name="Fujin Armour" id="a74d-dc8f-83ff-49a7" primary="false" targetId="3c36-c091-954c-6116"/>
        <categoryLink name="Infantry" id="21b6-1d7e-4988-1546" primary="false" targetId="f38e-18f6-4d87-3d0f"/>
      </categoryLinks>
      <costs>
        <cost name="Pts" typeId="10a6-c868-db09-c245" value="120"/>
      </costs>
      <infoLinks>
        <infoLink name="Stealth" id="fe0b-8484-4669-360c" hidden="false" targetId="a8a0-8fe7-898-e0f3" type="rule">
          <modifiers>
            <modifier field="name" join=" " type="append" value="24&quot;"/>
          </modifiers>
        </infoLink>
        <infoLink name="Resistance " id="e4d1-74d0-c45d-cff8" hidden="false" targetId="9bf4-280f-bbe2-6fbb" type="rule">
          <modifiers>
            <modifier field="name" join=" " type="append" value="8+"/>
          </modifiers>
        </infoLink>
        <infoLink name="Frenzied Slaughterers" id="1f90-65e7-3dbe-c0c8" hidden="false" targetId="735d-b41a-8e24-c6e0" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Bestial Trance" id="a36f-f434-7cec-095e" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This unit is always considered to be Frenzied. 


For every Frenzy counter this unit has, increase the attack characteristic of the Otu&apos;ran Ritual Blade by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Down with a fight" id="6bfb-c5a2-f8cd-1d5f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">If this unit has not fought this turn, and is reduced to 0 health, do not immediately remove it from play. Instead roll a D8, on a 6+ this unit may make melee attacks as if it had just made an Assault action. After it has resolved any melee attacks it is then removed from the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unstoppable charge" id="f156-b619-2ab7-c41f" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per turn, after an enemy unit has made a shoot action targeting this unit, if this unit lost any health as a result of that action it may make a normal move of D4+1&quot;. When doing so it cannot enter close combat range of any enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile name="Shielded Save" id="dd92-d5ad-d9a8-e04a" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">This model has a 6+ Shielded Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Bezerker" id="8de4-2e18-4019-288e" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="48e8-da1f-fb19-cf7b" field="selections" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="2e92-d24b-9a61-2e7b" field="selections" scope="parent" shared="true" type="max" value="1"/>
