        <profile name="Run with the pack (Aura)" id="ac4d-abf7-433c-69d4" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">After this unit activates and has resolved any actions. You may immediately activate 1 War-Beast Pack unit within 9&quot; of the Beast Master model that have not been activated this turn. That unit may not be activated again this stage.</characteristic>
          </characteristics>
        </profile>
        <profile name="Death of my master" id="dccf-c322-43ee-a498" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">When this units Beast Master model is destroyed, add 2 attacks characteristic and 1 to the strength characteristic of the Pet dogs melee weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
