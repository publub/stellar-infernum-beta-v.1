      <profiles>
        <profile name="Herald of Blood" id="cb8c-9bf2-7c92-29be" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">Once per game, during the strategy step, you may activate this ability. Models in this unit are considered to be Frenzied until the start of the next strategy step.

Note: When this ability ends, if the unit would be considered Frenzied for any other reason it continues to remain Frenzied.</characteristic>
          </characteristics>
        </profile>
        <profile name="Herald of the Ascendant (Aura)" id="50c7-f949-de13-5552" hidden="false" typeId="9cc3-6d83-4dd3-9b64" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="9b8f-694b-e5e-b573">CHUNARI units within 12&quot; of this model can reroll hit rolls of 1.</characteristic>
          </characteristics>
        </profile>
